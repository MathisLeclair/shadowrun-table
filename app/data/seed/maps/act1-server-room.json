  "notes": [
    {
      "id": "srv_n01",
      "x": 15,
      "y": 6,
      "text": "Porte maglock rating 5 : Serrurerie/Hardware seuil 5 ou badge cloné. L'ouvrir sans badge envoie une alerte silencieuse au poste du spider (sauf si Bricks a mis le capteur en boucle).",
      "gmOnly": true
    },
    {
      "id": "srv_n02",
      "x": 38,
      "y": 11,
      "text": "Junior Security Spider (acteur existant) en RV : son corps est vulnérable ici. Passe Standard Security Spider en cas d'alerte.",
      "gmOnly": true
    },
    {
      "id": "srv_n03",
      "x": 36,
      "y": 19,
      "text": "Archives papier : le dossier physique portant le vieux numéro Knight Errant (Phase 4 d'Open Book). Informatique/Recherche seuil 3, 10 minutes de fouille.",
      "gmOnly": true
    },
    {
      "id": "srv_n04",
      "x": 19,
      "y": 32,
      "text": "Gaine technique : on y rampe (déplacement /2). Relie salle des serveurs, bureau arrière et les immeubles voisins. Perception seuil 4 pour trouver les trappes depuis l'intérieur.",
      "gmOnly": true
    },
    {
      "id": "srv_n05",
      "x": 16,
      "y": 12,
      "text": "Console d'administration : accès direct au host Hollow Pine (Rating 5 — Att 6/Sle 8/DP 5/FW 7) sans passer par la Matrice publique : pas de bruit, IC de patrouille seulement.",
      "gmOnly": true
    },
    {
      "id": "srv_n06",
      "x": 5,
      "y": 28,
      "text": "Local onduleurs : couper l'alimentation éteint caméras et maglocks de l'étage pendant 3 tours, le temps que le groupe électrogène démarre.",
      "gmOnly": true
    },
    {
      "id": "srv_n07",
      "x": 13,
      "y": 17,
      "text": "Extinction au gaz inerte : si l'alarme incendie se déclenche, la salle est saturée en 3 tours (sortir ou subir la suffocation).",
      "gmOnly": true
    },
    {
      "id": "srv_n08",
      "x": 42,
      "y": 3,
      "text": "Monte-charge : arrive du quai de livraison. Bonne entrée déguisée en livreurs (Déguisement + faux bon de livraison).",
      "gmOnly": true
    }
