  "notes": [
    {
      "id": "jane_n01",
      "x": 41,
      "y": 16,
      "text": "Planque derrière la penderie (passage secret) : munitions, kit de déguisement de secours, créditubes. Contenu exact à valider avec le joueur de Jane.",
      "gmOnly": true
    },
    {
      "id": "jane_n02",
      "x": 36,
      "y": 25,
      "text": "Établi : kit de diagnostic électronique — Stades 1-2 de l'analyse de l'implant (seuils 3/6). Bricks peut y brancher son deck pour le Stade 3 (seuil 9).",
      "gmOnly": true
    },
    {
      "id": "jane_n03",
      "x": 20,
      "y": 27,
      "text": "Session 3 — la femme secourue sur le canapé, enroulée dans une couverture, sursaute au moindre bruit de couloir.",
      "gmOnly": true
    },
    {
      "id": "jane_n04",
      "x": 33,
      "y": 6,
      "text": "Apt 3C vide : si le signal de l'implant a été capté, un guetteur de Reyes s'y est installé (porte forcée : Perception seuil 4).",
      "gmOnly": true
    },
    {
      "id": "jane_n05",
      "x": 21,
      "y": 8,
      "text": "Mme Okafor (3B) : voit tout par son judas. Témoin gênant… ou alliée : elle a remarqué une voiture qui tourne dans la rue depuis deux jours.",
      "gmOnly": true
    },
    {
      "id": "jane_n06",
      "x": 37,
      "y": 30,
      "text": "Escalier de secours : seconde voie d'assaut (prise en tenaille avec la cage d'escalier). D'ici, on voit la voiture qui stationne trop longtemps en bas (session 3, scène 2).",
      "gmOnly": true
    },
    {
      "id": "jane_n07",
      "x": 11,
      "y": 9,
      "text": "Ascenseur en panne depuis des mois : seule voie rapide = l'escalier. Bon goulet d'étranglement pour tenir le couloir.",
      "gmOnly": true
    },
    {
      "id": "jane_n08",
      "x": 19,
      "y": 16,
      "text": "Porte blindée (Structure 8) + maglock rating 4. Caméra-judas reliée au commlink de Jane.",
      "gmOnly": true
    },
    {
      "id": "jane_n09",
      "x": 46,
      "y": 9,
      "text": "Apt 3D : couple d'orks bruyant, trideo à fond. Les coups de feu suppressés passent inaperçus ; les autres, non.",
      "gmOnly": true
    }
