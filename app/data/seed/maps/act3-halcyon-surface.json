  "notes": [
    {
      "id": "hsurf_n01",
      "x": 30,
      "y": 4,
      "text": "Guérite : 1 garde, lecteur de plaque. Approche A : la « cliente VIP » arrive en voiture, attendue (liste du gala, Margaux ou Calloway). Approche D : diversion du Crimson Crush ici pendant que le groupe passe par le quai.",
      "gmOnly": true
    },
    {
      "id": "hsurf_n02",
      "x": 40,
      "y": 9,
      "text": "2 drones MCT Fly-Spy survolent les jardins (esclaves du host). Un esprit de l'air (Force 4), lié par le mage de sécurité, patrouille l'astral au-dessus des jardins.",
      "gmOnly": true
    },
    {
      "id": "hsurf_n03",
      "x": 10,
      "y": 30,
      "text": "Rondes : 4 gardes Werkschutz (Sécurité corpo R4) en binômes, passage toutes les 20 minutes. Jardins sombres : éclairage bas, −1 visuel. Beaucoup de couverture légère (pins, lanternes, ponts).",
      "gmOnly": true
    },
    {
      "id": "hsurf_n04",
      "x": 25,
      "y": 16,
      "text": "Accueil : 2 gardes de nuit (Sécurité corpo humaine R3). Mur d'eau, orchidées, œuvres d'art. Hall éclairé toute la nuit. Ascenseurs publics : étages de chambres seulement (40 clients = 40 témoins puissants).",
      "gmOnly": true
    },
    {
      "id": "hsurf_n05",
      "x": 32,
      "y": 27,
      "text": "Ascenseur de service derrière la porte « Personnel » (badge + code) : descend au -1 et au -2. Le -3 n'est accessible que par l'ascenseur privé du -2.",
      "gmOnly": true
    },
    {
      "id": "hsurf_n06",
      "x": 33,
      "y": 13,
      "text": "Escalier de service vers le toit (maglock rating 5) : héliport (un Hughes WK-2 Stallion certains soirs — sortie si quelqu'un sait piloter), locaux techniques.",
      "gmOnly": true
    },
    {
      "id": "hsurf_n07",
      "x": 6,
      "y": 26,
      "text": "Bureau de la directrice médicale : une figurante sans lien avec Lazarus. Les salons de consultation servent aux clients de surface.",
      "gmOnly": true
    },
    {
      "id": "hsurf_n08",
      "x": 42,
      "y": 21,
      "text": "Piscine thermale intérieure sous verrière, hammam, salles de soin. La nuit : vide, embué, une bonne cachette (et un bon endroit pour noyer un problème).",
      "gmOnly": true
    },
    {
      "id": "hsurf_n09",
      "x": 25,
      "y": 24,
      "text": "Host de Halcyon rating 7 (A9/S7/DP8/F10), sculpture « jardin d'hiver infini » : caméras, maglocks, ascenseurs (sauf celui du -3), éclairage, ventilation, drones, valve de la Pépinière. Pas le coffre de données ni le -3. Knight Errant : 4 + 1D6 min, mais Halcyon ne l'appelle pas si les sous-sols sont compromis.",
      "gmOnly": true
    },
    {
      "id": "hsurf_n10",
      "x": 27,
      "y": 44,
      "text": "Ponton privé et hors-bord : sortie possible par le lac (ou entrée discrète, Discrétion contre les drones).",
      "gmOnly": true
    },
    {
      "id": "hsurf_n11",
      "x": 58,
      "y": 8,
      "text": "Barrière à badge. Caméras tous les 15 m dans tout le parking (esclaves du host).",
      "gmOnly": true
    },
    {
      "id": "hsurf_n12",
      "x": 60,
      "y": 44,
      "text": "Quai de chargement : arrivée des convois et du lot D (Reyes y amenait les donneurs). 2 gardes Werkschutz pendant le Protokoll Ernte. Approche E : le camion frigorifique attendu — les gardes ouvrent eux-mêmes. Monte-charge vers le -1 et le -2.",
      "gmOnly": true
    },
    {
      "id": "hsurf_n13",
      "x": 66,
      "y": 42,
      "text": "Cabine de contrôle vitrée : console des portes sectionnelles et du monte-charge, interphone avec le poste central du -1.",
      "gmOnly": true
    }
  ],
  "tokens": []
