  "notes": [
    {
      "id": "note_xenoform-research-lab_1",
      "x": 4,
      "y": 3,
      "text": "Dr. Hélène Dufresne, là la nuit. Elle ne se bat pas, elle protège ses données. Retournable : Negotiation + Charisme contre 7 dés, +3 si le groupe lui garantit une sortie (fille à Bruxelles). Serveur local + classeurs métalliques : dossiers papier des sujets, dont celui de L-02.",
      "gmOnly": true
    },
    {
      "id": "note_xenoform-research-lab_2",
      "x": 11,
      "y": 4,
      "text": "Pavillon L : chambres vitrées (verre renforcé Armor 6, Structure 6 ; maglocks rating 4). Ch. 1-4 : L-03, L-05, L-09, L-11. Ch. 5 vide, prête pour un transfert. Ch. 6 vide, porte renforcée, griffures. Néons allumés en permanence.",
      "gmOnly": true
    },
    {
      "id": "note_xenoform-research-lab_3",
      "x": 4,
      "y": 8,
      "text": "Gardes AG Chemie (tpl_corpsec_r4) : 2 en ronde, 2 en salle de sécurité, 4 au repos ; Stadler ; une mage de sécurité en ronde astrale toutes les heures ; Junior Spider.",
      "gmOnly": true
    }
