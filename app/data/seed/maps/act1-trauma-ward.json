  "notes": [
    {
      "id": "ward_n01",
      "x": 43,
      "y": 6,
      "text": "Chambre 23 : la femme secourue y convalescait sous un faux nom (session 2). Dossier patient falsifié dans le terminal de l'accueil.",
      "gmOnly": true
    },
    {
      "id": "ward_n02",
      "x": 16,
      "y": 24,
      "text": "Poste de sécurité : 1 Human Corpo Security R3 (2 la nuit). Flux des caméras : hall des ascenseurs, accueil, couloir (2 caméras, extrémités), poste infirmier, sas du bloc. Couper les flux : Hacking sur le host Monobe (Firewall 10) ou débrancher ici.",
      "gmOnly": true
    },
    {
      "id": "ward_n03",
      "x": 27,
      "y": 23,
      "text": "Poste infirmier : 2 infirmières, 1 interne. Étiquette/Escroquerie seuil 3 pour passer pour de la famille ou un médecin.",
      "gmOnly": true
    },
    {
      "id": "ward_n04",
      "x": 29,
      "y": 31,
      "text": "Pharmacie : sédatifs (propofol, midazolam — même cocktail que les Nettoyeurs), medkits rating 3-6. Serrurerie seuil 4 ; vol remarqué en 1D6 h.",
      "gmOnly": true
    },
    {
      "id": "ward_n05",
      "x": 51,
      "y": 25,
      "text": "Bloc : kit de diagnostic complet. Permet les Stades 1-2 de l'analyse de l'implant oculaire (seuils 3/6) et l'extraction du module (Médecine seuil 5).",
      "gmOnly": true
    },
    {
      "id": "ward_n06",
      "x": 3,
      "y": 12,
      "text": "Hall des ascenseurs : caméra au plafond. Session 2 — l'équipe de Reyes montait par l'ascenseur pendant que le groupe repartait par l'escalier (jamais croisée).",
      "gmOnly": true
    },
    {
      "id": "ward_n07",
      "x": 54,
      "y": 18,
      "text": "Sortie de secours : ouvrir déclenche l'alarme de l'étage (sauf Électronique seuil 3 pour shunter le contact).",
      "gmOnly": true
    },
    {
      "id": "ward_n08",
      "x": 9,
      "y": 31,
      "text": "Local technique : tableau électrique de l'aile. Couper le courant = obscurité 10 s avant les éclairages de secours (rouges, ambiance « dim »).",
      "gmOnly": true
    },
    {
      "id": "ward_n09",
      "x": 38,
      "y": 27,
      "text": "Réserve : fauteuils roulants, brancards, blouses — de quoi déguiser une extraction (Déguisement +2).",
      "gmOnly": true
    }
