  "doors": [],
  "notes": [
    {
      "id": "note_tailor-shop_1",
      "x": 1,
      "y": 6,
      "text": "Vitrine et porte vitrée automatique : verre ordinaire. Ouvert 24 h/24 ; à 3 h du matin, un ou deux clients de passage (témoins). Néons blancs fatigués, éclairée en permanence.",
      "gmOnly": true
    },
    {
      "id": "note_tailor-shop_2",
      "x": 4,
      "y": 6,
      "text": "Salle des machines : machines = couverture partielle (Armor 6, Structure 8) ; sèche-linge en marche : –2 Perception auditive. Trois des six sèche-linge cachent des caméras câblées vers le sous-sol (Perception + Intuition seuil 4). Fly-Spy de Windows dans une dalle du faux plafond : il voit les assaillants à deux rues (3 tours d’avance).",
      "gmOnly": true
    },
    {
      "id": "note_tailor-shop_3",
      "x": 9,
      "y": 3,
      "text": "Arrière-boutique (porte « Privé », serrure mécanique rating 2) : étagères de lessive, chaudière, deux drones GMC-Nissan Doberman en veille (Colt Cobra TZ-120). Porte blindée vers l’escalier du sous-sol : Structure 12 / Armor 12, maglock rating 5 câblé (séquenceur ou accès physique). Porte forcée = interrupteur d’homme mort.",
      "gmOnly": true
    },
    {
      "id": "note_tailor-shop_4",
      "x": 7,
      "y": 6,
      "text": "Si Reyes vient : 2 Crimson Crush à moto en guetteurs au coin de la rue ; Reyes + 4 Nettoyeurs entrent par la vitrine ET par l’allée. Équipe du Passeur (Phase 4) : Rempart enfonce la porte de service, le Passeur et Cendre entrent par la vitrine ; ils veulent Windows vivante.",
      "gmOnly": true
    }
  ],
