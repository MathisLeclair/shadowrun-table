  "doors": [],
  "notes": [
    {
      "id": "note_basement-utility-room_1",
      "x": 8,
      "y": 6,
      "text": "Escalier étroit : une seule personne à la fois — le goulot de l’assaut. La porte blindée en haut est câblée à l’interrupteur d’homme mort.",
      "gmOnly": true
    },
    {
      "id": "note_basement-utility-room_2",
      "x": 7,
      "y": 8,
      "text": "Cage de Faraday : aucune connexion sans fil n’entre ni ne sort (Bricks est coupée de la Matrice). Windows (pistolet braqué) ouvre si Bricks se présente devant une caméra. Serveur dans une armoire métallique, charge thermite reliée au bracelet de Windows : pression relâchée ou porte forcée → effacement en 30 s.",
      "gmOnly": true
    },
    {
      "id": "note_basement-utility-room_3",
      "x": 5,
      "y": 8,
      "text": "Mur couvert de photos et de fils rouges : six ans d’enquête sur Harlan Kessler. Au centre, une photo de l’Escouade 9 — Bricks y est.",
      "gmOnly": true
    },
    {
      "id": "note_basement-utility-room_4",
      "x": 7,
      "y": 11,
      "text": "Ancien conduit à charbon (0,8 m), caché (Perception seuil 4) : on y rampe une personne à la fois (déplacement /2). Il remonte dans l’allée par une trappe en fonte — l’issue de secours de Windows.",
      "gmOnly": true
    }
  ],
