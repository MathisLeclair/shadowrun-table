{
  "name": "shadowrun-table",
  "version": "1.0.0",
  "description": "Table de jeu Shadowrun 5E — Project Lazarus (MJ + joueurs en temps réel)",
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch-path=server --watch-path=shared server/index.ts --vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "build:catalog": "node tools/build-catalog.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "adm-zip": "^0.6.1",
    "classic-level": "^3.0.0",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.12.1",
    "jpeg-js": "^0.4.4",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
